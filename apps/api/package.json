{
  "name": "@4sports/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "bun run src/shared/db/seeds/index.ts",
    "db:seed:dummy": "bun run src/shared/db/seeds/dummy/index.ts",
    "db:generate:auth": "bunx --bun @better-auth/cli generate --config ./src/shared/lib/auth.ts --output ./src/shared/db/schemas/auth.schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.797.0",
    "@aws-sdk/s3-request-presigner": "^3.797.0",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "ioredis": "^5.10.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "bun-types": "latest",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9"
  },
  "module": "src/index.js"
}
