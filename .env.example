# API
## Server
PORT=4000

## Database
DATABASE_URL=postgresql://4sports:4sports_pass@localhost:5432/4sports_dev
REDIS_URL=redis://localhost:6379

## BetterAuth
BETTER_AUTH_SECRET= # openssl rand -base64 32
API_URL=http://localhost:4000

# - **Google**: Crea una aplicación en [Google Cloud Console](https://console.cloud.google.com) → APIs & Services → Credentials → OAuth 2.0 Client ID. URI de redirección: `{API_URL}/auth/callback/google`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# - **Facebook**: Crea una app en [Meta for Developers](https://developers.facebook.com) → Facebook Login. URI de redirección: `{API_URL}/auth/callback/facebook`
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

WEB_URL=http://localhost:3000
MOBILE_URL=exp://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (email notifications)
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Override sender address (optional — defaults to invitaciones@4sports.app)
RESEND_FROM_EMAIL=

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Logs
LOG_LEVEL=debug
LOG_FILE=logs/api.log
