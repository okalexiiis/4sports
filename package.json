{
  "name": "4sports",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@4sports/api",
    "dev:web": "turbo run dev --filter=@4sports/web",
    "dev:mobile": "turbo run dev --filter=@4sports/mobile",
    "dev:all": "turbo run dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "docker:postgres": "docker compose -f docker/postgres/docker-compose.yml up -d",
    "docker:redis": "docker compose -f docker/redis/docker-compose.yml up -d",
    "docker:up": "docker compose -f docker/postgres/docker-compose.yml -f docker/redis/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/postgres/docker-compose.yml -f docker/redis/docker-compose.yml down",
    "docker:logs:postgres": "docker compose -f docker/postgres/docker-compose.yml logs -f",
    "docker:logs:redis": "docker compose -f docker/redis/docker-compose.yml logs -f",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@sinclair/typebox": "^0.34.49"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.9.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.0.0"
}
