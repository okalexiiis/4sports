      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Rank is never stored fixed; every query recomputes from completed matches applying settings.tiebreaker[] hierarchically. Tiebreakers lock after the first completed match."
