      "id": "observability_readme_log_pipeline",
      "label": "Log Pipeline (API file -> Promtail -> Loki -> Grafana)",
      "file_type": "rationale",
      "source_file": "docker/observability/README.md",
      "source_location": "How it works",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The API is fully decoupled from observability: it only writes JSON log lines to a file, and Promtail/Loki/Grafana are optional Docker containers layered on top, so the app has zero runtime dependency on the log stack."
    },
    {
      "id": "observability_readme_log_file_env",
      "label": "LOG_FILE Environment Variable",
      "file_type": "concept",
      "source_file": "docker/observability/README.md",
      "source_location": "Setup step 1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "LOG_FILE=logs/api.log makes Pino tee JSON logs to a file (relative to apps/api/) in addition to pretty terminal output, for Promtail to scrape. It must NOT be set in production, where writing JSON to stdout only is the correct behaviour for hosted environments."
    },
