    {
      "id": "hitos_hito_3_match_state_machine",
      "label": "Match Lifecycle State Machine",
      "file_type": "concept",
      "source_file": "agent_docs/hitos/hito-3.md",
      "source_location": "section 3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Strict state machine on matches.status (scheduled/postponed/live/suspended/finished/disputed/walkover/cancelled) \u2014 states cannot be skipped, preserving competition integrity."
    },
    {
      "id": "hitos_hito_3_finish_match_transaction",
      "label": "Match Finish Atomic Transaction",
      "file_type": "rationale",
      "source_file": "agent_docs/hitos/hito-3.md",
      "source_location": "section 6.2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "POST /matches/:id/finish runs score calc, winner, standings recalc, suspension confirmation, BullMQ enqueue and bracket advance in ONE PostgreSQL transaction \u2014 full rollback on any failure so a match never ends inconsistent."
    },
    {
      "id": "hitos_hito_3_standings_recalculation",
      "label": "Full Standings Recalculation (no incremental deltas)",
      "file_type": "rationale",
      "source_file": "agent_docs/hitos/hito-3.md",
      "source_location": "section 6.3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Recalculation reads ALL finished matches and rebuilds the table from scratch instead of applying deltas, to avoid drift/inconsistencies after corrections and disputes."
    },
    {
      "id": "hitos_hito_3_bullmq_queues",
      "label": "BullMQ Notification & Audit Queues",
      "file_type": "concept",
      "source_file": "agent_docs/hitos/hito-3.md",
      "source_location": "section 8",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "hitos_hito_3_live_websocket_protocol",
      "label": "Live Match WebSocket Protocol (ws://api/ws/matches/:id)",
      "file_type": "concept",
      "source_file": "agent_docs/hitos/hito-3.md",
      "source_location": "section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Sub-5-second score latency target; Redis caches active match state to shield PostgreSQL during simultaneous write peaks \u2014 DB stays the source of truth."
    }
