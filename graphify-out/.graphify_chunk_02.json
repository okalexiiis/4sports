      "id": "dev_docs_frontend_dev_guide_betterauth_session_auth",
      "label": "BetterAuth Session Cookie Authentication (Client Side)",
      "file_type": "concept",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/frontend-dev-guide.md",
      "source_location": "section 2",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Web relies on browser cookie handling via fetch credentials:'include'; mobile must persist and resend the better-auth.session_token cookie manually (expo-secure-store or BetterAuth RN client) because React Native has no cookie jar."
    },
    {
