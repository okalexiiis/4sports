      "label": "Promtail Service (4sports-promtail)",
      "file_type": "code",
      "source_file": "/home/okalexiiis/dev/4sports/docker/observability/docker-compose.yml",
      "source_location": "services.promtail",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Mounts ../../apps/api/logs read-only into /logs/api so log scraping needs no Docker socket and no agent inside the API process."
