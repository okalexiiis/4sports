    {
      "id": "observability_docker_compose_grafana_service",
      "label": "Grafana Service (4sports-grafana, host port 3001)",
      "file_type": "code",
      "source_file": "/home/okalexiiis/dev/4sports/docker/observability/docker-compose.yml",
      "source_location": "services.grafana",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Anonymous access is enabled with Admin org role (GF_AUTH_ANONYMOUS_*) so local developers query logs without login; host port 3001 avoids clashing with the web app on 3000."
    },
    {
      "id": "datasources_loki_loki_datasource",
      "label": "Grafana Loki Datasource Provisioning",
      "file_type": "code",
      "source_file": "/home/okalexiiis/dev/4sports/docker/observability/grafana/provisioning/datasources/loki.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Provisioned as the default datasource (isDefault: true) pointing at http://loki:3100 so Grafana is query-ready on first boot with no manual setup."
    },
    {
      "id": "observability_loki_config_loki_config",
      "label": "Loki Single-Node Config (tsdb + filesystem)",
      "file_type": "code",
      "source_file": "/home/okalexiiis/dev/4sports/docker/observability/loki-config.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dev-only single-node setup: auth disabled, in-memory ring, replication_factor 1, tsdb schema v13 on local filesystem, samples older than 168h rejected, analytics reporting off."
    },
    {
      "id": "observability_promtail_config_api_logs_scrape",
      "label": "Promtail api_logs Scrape Config",
      "file_type": "code",
      "source_file": "/home/okalexiiis/dev/4sports/docker/observability/promtail-config.yaml",
      "source_location": "scrape_configs.api_logs",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tails /logs/api/*.log with static label service=api and promotes JSON fields level and type to Loki labels so LogQL can filter on them."
    },
    {
      "id": "observability_promtail_config_pino_level_mapping",
      "label": "Pino Numeric Level to String Mapping",
      "file_type": "rationale",
      "source_file": "/home/okalexiiis/dev/4sports/docker/observability/promtail-config.yaml",
      "source_location": "pipeline_stages.template",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Pino serializes log levels as numbers (10..60) when transport.targets is used (a Pino limitation), so a Promtail template stage maps 10->trace .. 60->fatal to keep the Loki level label human-queryable ({level=\"error\"})."
    },
