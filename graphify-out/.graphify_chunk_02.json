      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "BetterAuth self-generates OpenAPI docs for all /auth/* routes via the openAPI() plugin registered in src/shared/lib/auth.ts, so auth endpoints never need hand-written docs."
    },
