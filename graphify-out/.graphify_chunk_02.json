    {
      "id": "dev_docs_josue_dev_guide_authguard",
      "label": "authGuard Middleware",
      "file_type": "concept",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/josue-dev-guide.md",
      "source_location": "sections 3, 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Every private route must apply authGuard as an Elysia plugin before the handler; it lives at src/shared/middleware/auth.guard.ts."
    },
    {
      "id": "dev_docs_josue_dev_guide_orgguard",
      "label": "orgGuard(minRole) Middleware",
      "file_type": "concept",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/josue-dev-guide.md",
      "source_location": "sections 3, 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Routes operating on an organization apply orgGuard with a minimum role (e.g. orgGuard('organizer')); lives at src/shared/middleware/org.guard.ts."
    },
    {
      "id": "dev_docs_josue_dev_guide_featureguard",
      "label": "featureGuard(feature) Middleware",
      "file_type": "concept",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/josue-dev-guide.md",
      "source_location": "sections 3, 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Routes gated behind a subscription plan apply featureGuard('feature_key'); lives at src/shared/middleware/feature.guard.ts."
    },
    {
      "id": "dev_docs_josue_dev_guide_thin_route_handler",
      "label": "Thin Route Handler Rule",
      "file_type": "rationale",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/josue-dev-guide.md",
      "source_location": "section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Route handlers in routes.ts may only call a use case and pass the result to toApiResponse; business logic never lives in HTTP handlers so it stays testable and transport-agnostic."
    },
    {
      "id": "dev_docs_josue_dev_guide_use_case_result_pattern",
      "label": "Use Case Result Pattern",
      "file_type": "rationale",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/josue-dev-guide.md",
      "source_location": "section 5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Business logic is a pure async function (repo, input) -> Promise<Result<T>> that never throws; it returns ok(data) or err(domainError) so error flow is explicit and type-checked under strict TypeScript (no any, no ! assertions)."
    },
    {
      "id": "dev_docs_josue_dev_guide_betterauth_openapi_reference",
      "label": "BetterAuth OpenAPI Reference (/auth/reference)",
      "file_type": "concept",
      "source_file": "/home/okalexiiis/dev/4sports/dev_docs/josue-dev-guide.md",
